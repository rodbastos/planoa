# ---------------------------------------------------------------------------
# Credencial Firebase — service account do projeto plano-alloca.
# Console Firebase → Configurações do projeto → Contas de serviço →
# "Gerar nova chave privada". Escolha UMA das opções abaixo:
# ---------------------------------------------------------------------------

# Opção 1 (recomendada): caminho para o arquivo JSON baixado
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/rodri/alloca/mcp/service-account.json

# Opção 2: conteúdo do JSON inteiro numa única linha (útil em túneis/deploys)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"plano-alloca",...}

# ---------------------------------------------------------------------------
# Usuário dono dos dados — UMA das opções:
# ---------------------------------------------------------------------------

# UID do Firebase Auth (aparece em Authentication → Users)
ALLOCA_UID=

# ...ou o e-mail da conta Google usada no app
# ALLOCA_USER_EMAIL=voce@gmail.com

# ---------------------------------------------------------------------------
# Transporte HTTP (para ChatGPT / clientes remotos)
# ---------------------------------------------------------------------------

# Porta do modo HTTP (npm run start:http)
# PORT=8787

# Token obrigatório no modo HTTP quando definido:
#   Authorization: Bearer <token>   ou   ?token=<token> na URL
# Gere um valor aleatório forte — quem tiver o token lê e ESCREVE na carteira.
# MCP_AUTH_TOKEN=troque-por-um-segredo-longo
